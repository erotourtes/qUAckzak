<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           elementFormDefault="qualified">
  <xs:simpleType name="nonEmptyString">
    <xs:restriction base="xs:string">
      <xs:minLength value="1" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="identifier">
    <xs:restriction base="xs:string">
      <xs:pattern value="[a-z0-9][a-z0-9_-]*" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="layer">
    <xs:restriction base="xs:string">
      <xs:enumeration value="inherit" />
      <xs:enumeration value="behind" />
      <xs:enumeration value="front" />
      <xs:enumeration value="foreground" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="facing">
    <xs:restriction base="xs:string">
      <xs:enumeration value="inherit" />
      <xs:enumeration value="movement" />
      <xs:enumeration value="fixed" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="controller">
    <xs:restriction base="xs:string">
      <xs:enumeration value="attached" />
      <xs:enumeration value="flying_follower" />
      <xs:enumeration value="ground_follower" />
      <xs:enumeration value="world_one_shot" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="trigger">
    <xs:restriction base="xs:string">
      <xs:enumeration value="default" />
      <xs:enumeration value="idle" />
      <xs:enumeration value="running" />
      <xs:enumeration value="airborne" />
      <xs:enumeration value="crouching" />
      <xs:enumeration value="sliding" />
      <xs:enumeration value="ragdoll" />
      <xs:enumeration value="netted" />
      <xs:enumeration value="direction_changed" />
      <xs:enumeration value="death" />
      <xs:enumeration value="follower_moving" />
      <xs:enumeration value="follower_idle" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="stateTrigger">
    <xs:restriction base="trigger">
      <xs:enumeration value="default" />
      <xs:enumeration value="idle" />
      <xs:enumeration value="running" />
      <xs:enumeration value="airborne" />
      <xs:enumeration value="crouching" />
      <xs:enumeration value="sliding" />
      <xs:enumeration value="ragdoll" />
      <xs:enumeration value="netted" />
      <xs:enumeration value="follower_moving" />
      <xs:enumeration value="follower_idle" />
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="cadence">
    <xs:restriction base="xs:string">
      <xs:enumeration value="time" />
      <xs:enumeration value="distance" />
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="animationType">
    <xs:attribute name="trigger" type="trigger" use="required" />
    <xs:attribute name="firstFrame" type="xs:nonNegativeInteger" use="required" />
    <xs:attribute name="lastFrame" type="xs:nonNegativeInteger" use="required" />
    <xs:attribute name="ticksPerFrame" type="xs:positiveInteger" use="required" />
  </xs:complexType>

  <xs:complexType name="emitterType">
    <xs:attribute name="condition" type="stateTrigger" use="required" />
    <xs:attribute name="cadence" type="cadence" use="required" />
    <xs:attribute name="minimumInterval" type="xs:positiveInteger" use="required" />
    <xs:attribute name="maximumInterval" type="xs:positiveInteger" use="required" />
  </xs:complexType>

  <xs:complexType name="componentType">
    <xs:sequence>
      <xs:element name="animation" type="animationType" minOccurs="0" maxOccurs="unbounded" />
      <xs:element name="emitter" type="emitterType" minOccurs="0" />
    </xs:sequence>
    <xs:attribute name="id" type="identifier" use="required" />
    <xs:attribute name="sprite" type="nonEmptyString" use="required" />
    <xs:attribute name="frameWidth" type="xs:positiveInteger" />
    <xs:attribute name="frameHeight" type="xs:positiveInteger" />
    <xs:attribute name="parent" type="identifier" default="duck" />
    <xs:attribute name="offsetX" type="xs:decimal" default="0" />
    <xs:attribute name="offsetY" type="xs:decimal" default="0" />
    <xs:attribute name="layer" type="layer" default="front" />
    <xs:attribute name="facing" type="facing" default="inherit" />
    <xs:attribute name="controller" type="controller" default="attached" />
    <xs:attribute name="speed" type="xs:decimal" />
    <xs:attribute name="group" type="identifier" />
  </xs:complexType>

  <xs:element name="hat">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="component" type="componentType" minOccurs="0" maxOccurs="unbounded" />
      </xs:sequence>
      <xs:attribute name="name" type="nonEmptyString" use="required" />
      <xs:attribute name="preview" type="nonEmptyString" default="preview.png" />
      <xs:attribute name="image" type="nonEmptyString" default="hat.png" />
    </xs:complexType>
    <xs:unique name="uniqueComponentId">
      <xs:selector xpath="component" />
      <xs:field xpath="@id" />
    </xs:unique>
  </xs:element>
</xs:schema>
