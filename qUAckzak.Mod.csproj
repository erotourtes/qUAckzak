<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>qUAckzak.Mod</RootNamespace>
    <!-- The loader strips the .Mod suffix from the directory name. -->
    <AssemblyName>qUAckzak</AssemblyName>
    <AssemblyTitle>qUAckzak</AssemblyTitle>
    <Company>erotourtes</Company>
    <Description>Duck Game mod for feeling as a qUAckzak</Description>
    <Version>0.0.1</Version>
    <AssemblyVersion>0.0.1.0</AssemblyVersion>
    <FileVersion>0.0.1.0</FileVersion>
    <InformationalVersion>0.0.1</InformationalVersion>
    <PlatformTarget>x86</PlatformTarget>
    <LangVersion>14.0</LangVersion>
    <EnableDefaultItems>false</EnableDefaultItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>build/$(Configuration)/</OutputPath>
    <BaseIntermediateOutputPath>obj/</BaseIntermediateOutputPath>
    <IntermediateOutputPath>obj/$(Configuration)/</IntermediateOutputPath>
    <DuckGameDir Condition="'$(DuckGameDir)' == '' and Exists('/opt/duckgame/rebuilt/DuckGame.exe')">/opt/duckgame/rebuilt</DuckGameDir>
    <DuckGameDir Condition="'$(DuckGameDir)' == ''">$(MSBuildProjectDirectory)/.local/duckgame-rebuilt</DuckGameDir>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>portable</DebugType>
    <Optimize>false</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies"
                      Version="1.0.3"
                      PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="DuckGame">
      <HintPath>$(DuckGameDir)/DuckGame.exe</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="FNA">
      <HintPath>$(DuckGameDir)/FNA.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(DuckGameDir)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="src/**/*.cs" />
    <Content Include="content/**/*" />
    <EmbeddedResource Include="schemas/quackhat.xsd"
                      LogicalName="qUAckzak.QuackHat.Schema.xsd" />
    <None Include="mod.conf" />
  </ItemGroup>

  <Target Name="CheckDuckGameInstall" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(DuckGameDir)/DuckGame.exe')"
           Text="Duck Game Rebuilt's DuckGame.exe was not found in '$(DuckGameDir)'. Create the ignored .local/duckgame-rebuilt symlink." />
    <Error Condition="!Exists('$(DuckGameDir)/FNA.dll')"
           Text="Duck Game Rebuilt's FNA.dll was not found in '$(DuckGameDir)'. Create the ignored .local/duckgame-rebuilt symlink." />
    <Error Condition="!Exists('$(DuckGameDir)/0Harmony.dll')"
           Text="Duck Game Rebuilt's 0Harmony.dll was not found in '$(DuckGameDir)'. Create the ignored .local/duckgame-rebuilt symlink." />
  </Target>

  <Target Name="CleanAll">
    <RemoveDir Directories="$(MSBuildProjectDirectory)/build;
                            $(MSBuildProjectDirectory)/obj" />
    <Message Text="Removed generated build and intermediate files."
             Importance="high" />
  </Target>
</Project>
